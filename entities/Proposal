{
  "name": "Proposal",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "service_date": {
      "type": "string",
      "format": "date"
    },
    "validity_days": {
      "type": "number",
      "default": 30
    },
    "status": {
      "type": "string",
      "enum": [
        "aberta",
        "fechada",
        "expirada",
        "arquivada"
      ],
      "default": "aberta"
    },
    "commercial_status": {
      "type": "string",
      "enum": [
        "sem_resposta",
        "negociando",
        "aceita",
        "negada",
        "personalizado"
      ],
      "description": "Status comercial da proposta"
    },
    "notes": {
      "type": "string",
      "description": "Anota\u00e7\u00f5es internas do prestador"
    },
    "followup_type": {
      "type": "string",
      "description": "Tipo de acompanhamento"
    },
    "custom_changes": {
      "type": "object",
      "description": "Altera\u00e7\u00f5es personalizadas quando tipo=personalizado",
      "properties": {
        "items_added": {
          "type": "string"
        },
        "items_removed": {
          "type": "string"
        },
        "agreed_value": {
          "type": "string"
        }
      }
    },
    "hero_video_url": {
      "type": "string"
    },
    "wedding_photo_url": {
      "type": "string"
    },
    "backstage_media": {
      "type": "array",
      "description": "Fotos e v\u00eddeos de backstage",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          }
        }
      }
    },
    "differentials_media": {
      "type": "array",
      "description": "Fotos e v\u00eddeos da se\u00e7\u00e3o de diferenciais",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          }
        }
      }
    },
    "package_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "theme": {
      "type": "string",
      "default": "dark_luxury"
    },
    "theme_custom": {
      "type": "object"
    },
    "overrides": {
      "type": "object",
      "description": "Campos que sobrescrevem o padr\u00e3o do Provider.",
      "additionalProperties": true
    }
  },
  "required": [
    "client_name",
    "slug"
  ]
}